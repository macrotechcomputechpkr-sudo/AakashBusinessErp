# Global Master DB
GLOBAL_MASTER_URL=https://your-master-db.supabase.co
GLOBAL_MASTER_KEY=your-master-db-anon-key

# JWT
JWT_SECRET=change-this-to-a-long-random-string

# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (FIX: previously cors()
# with no options allowed every origin, which is unsafe for production).
CORS_ORIGINS=http://localhost:3000
